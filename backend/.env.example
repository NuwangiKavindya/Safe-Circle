# ==============================================================================
# Safe-Circle Backend Environment Configuration
# ==============================================================================

# Server Runtime Settings
PORT=5001
NODE_ENV=production

# PostgreSQL Database Configuration
# When using two t3.micro EC2 instances, DB_HOST should be the private IP of the DB EC2 instance (e.g., 10.0.2.x)
DB_HOST=10.0.2.100
DB_PORT=5432
DB_NAME=safe_circle
DB_USER=safe_circle_user
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_random_string
JWT_EXPIRE_DAYS=30

# Google OAuth Client IDs (Google SSO Authentication)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Email SMTP Notification Settings (Nodemailer / Emergency Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_or_smtp_key
SMTP_FROM="SafeCircle Security" <no-reply@safecircle.com>

# AES-256-GCM Encryption key for TOTP secrets at rest (32-byte hex string)
TOTP_ENCRYPTION_KEY=your_secure_32_byte_hex_key_here

# Security gate for sandbox tokens (Never enable in production)
ENABLE_AUTH_SANDBOX=false

